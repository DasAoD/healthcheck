# ============================================================
# healthcheck – Umgebungsvariablen (Vorlage)
# Kopiere diese Datei als .env und trage deine Werte ein.
# Die .env wird NIEMALS ins Git-Repository committet!
# ============================================================

# Datenbankpfad (absolut oder relativ zum Projektroot)
DB_PATH=/var/www/healthcheck/data/healthcheck.db

# Anwendungs-URL (ohne abschließenden Slash)
APP_URL=https://healthcheck.example.com

# Session-Secret (mind. 32 zufällige Zeichen)
SESSION_SECRET=CHANGE_ME_TO_RANDOM_STRING_32CHARS

# Debug-Modus (0 = Produktion, 1 = Entwicklung)
APP_DEBUG=0

# Zeitzone
APP_TIMEZONE=Europe/Berlin

# ── Telegram ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── E-Mail (SMTP) ────────────────────────────────────────────
MAIL_FROM=healthcheck@example.com
MAIL_TO=admin@example.com
MAIL_SMTP_HOST=smtp.example.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
